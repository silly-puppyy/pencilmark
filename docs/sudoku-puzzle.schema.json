{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://silly-puppyy.github.io/pencilmark/schema/sudoku-puzzle-1.json",
 "title": "sudoku-puzzle format_version 1",
 "description": "pencilmark exchange format (docs/FORMAT.md). Checks that need the board (cells exist, adjacency, outside-clue geometry, digits within 1..D, givens length) are made by the reference reader (pencilmark.validate).",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "grid",
  "digits",
  "givens",
  "rules"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "format": {
   "const": "sudoku-puzzle"
  },
  "format_version": {
   "const": 1
  },
  "meta": {
   "type": "object"
  },
  "grid": {
   "type": "object",
   "required": [
    "rows",
    "cols"
   ],
   "additionalProperties": false,
   "properties": {
    "rows": {
     "type": "integer",
     "minimum": 1
    },
    "cols": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "digits": {
   "type": "integer",
   "minimum": 1
  },
  "givens": {
   "type": "array",
   "items": {
    "type": [
     "integer",
     "null"
    ],
    "minimum": 0
   }
  },
  "solution": {
   "type": "array",
   "items": {
    "type": [
     "integer",
     "null"
    ],
    "minimum": 1
   }
  },
  "candidates": {
   "type": "object",
   "propertyNames": {
    "$ref": "#/$defs/cell"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 1
    },
    "uniqueItems": true
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rule"
   }
  },
  "decorations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/decoration"
   }
  },
  "style": {
   "type": "object"
  },
  "ext": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
   }
  }
 },
 "$defs": {
  "cell": {
   "type": "string",
   "pattern": "^[rR][1-9][0-9]*[cC][1-9][0-9]*$"
