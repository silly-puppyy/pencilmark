     "maxItems": 2
    },
    "cells": {
     "$ref": "#/$defs/cells"
    },
    "origin": {
     "$ref": "#/$defs/cell"
    },
    "size": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "type",
    "size"
   ],
   "additionalProperties": false,
   "oneOf": [
