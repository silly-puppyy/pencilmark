{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://silly-puppyy.github.io/pencilmark/schema/sudoku-puzzle-1.json",
 "title": "sudoku-puzzle format_version 1",
 "description": "pencilmark exchange format (docs/formats/puzzle-format.md). Checks that need the board (cells exist, adjacency, outside-clue geometry, digits within 1..D, givens length) are made by the reference reader (pencilmark.validate).",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "board",
  "digits",
  "givens",
  "rules"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "format": {
   "const": "sudoku-puzzle"
  },
  "format_version": {
   "const": 1
  },
  "meta": {
   "type": "object"
  },
  "board": {
   "type": "object",
   "required": [
    "rows",
    "cols"
   ],
   "additionalProperties": false,
   "properties": {
    "rows": {
     "type": "integer",
     "minimum": 1
    },
    "cols": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "digits": {
   "type": "integer",
   "minimum": 1
  },
  "givens": {
   "type": "array",
   "items": {
    "type": [
     "integer",
     "null"
    ],
    "minimum": 0
   }
  },
  "solution": {
   "type": "array",
   "items": {
    "type": [
     "integer",
     "null"
    ],
    "minimum": 1
   }
  },
  "candidates": {
   "type": "object",
   "propertyNames": {
    "$ref": "#/$defs/cell"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 1
    },
    "uniqueItems": true
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rule"
   }
  },
  "unknowns": {
   "type": "object",
   "description": "named unknown numbers custom rules read (rules/custom.mdx, unknowns and layers)",
   "propertyNames": {
    "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "values": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
     },
     "range": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "additionalProperties": false
   }
  },
  "layers": {
   "type": "object",
   "description": "named values per cell custom rules read (rules/custom.mdx, unknowns and layers)",
   "propertyNames": {
    "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "values": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
     },
     "range": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "given": {
      "type": "object",
      "propertyNames": {
       "pattern": "^r[0-9]+c[0-9]+$"
      },
      "additionalProperties": {
       "type": "integer"
      }
     }
    },
    "additionalProperties": false
   }
  },
  "decorations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/decoration"
   }
  },
  "style": {
   "type": "object"
  }
 },
 "$defs": {
  "cell": {
   "type": "string",
   "pattern": "^[rR][1-9][0-9]*[cC][1-9][0-9]*$"
  },
  "cells": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cell"
   },
   "minItems": 1
  },
  "style": {
   "type": "object"
  },
  "rule_grid": {
