# Doxygen reads the comments in csrc/ into XML; tools/gen_cpp_reference.py turns the XML into the C++ reference pages
# of the docs site (docs/dev/reference/cpp-*.md). Run that script, not doxygen.
PROJECT_NAME           = "pencilmark engine"
INPUT                  = csrc
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = NO
OUTPUT_DIRECTORY       = build/doxygen-xml
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = .
XML_PROGRAMLISTING     = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = build/doxygen-warnings.log
